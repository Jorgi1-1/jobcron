    "cheerio": "^1.0.0",
    "nodemailer": "^9.0.5",
    "resend": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/nodemailer": "^6.4.16",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=18"
  }
}
